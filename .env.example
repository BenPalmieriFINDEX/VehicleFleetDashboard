# Database — PostgreSQL connection string (provided by Railway)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# JWT signing secret — use a long random string (openssl rand -hex 64)
JWT_SECRET="your-very-long-random-jwt-secret-here"

# Cookie signing secret
COOKIE_SECRET="your-cookie-secret-here"

# Anthropic API key for Claude AI assistant
ANTHROPIC_API_KEY="sk-ant-..."

# Node environment
NODE_ENV="development"

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# Server port (Railway sets this automatically)
PORT=3001
